{
  "manifest_version": 3,
  "name": "Sahm Download Integration",
  "version": "1.1.1",
  "description": "Send downloads and videos to the Sahm Download Manager desktop app.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Sahm" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
